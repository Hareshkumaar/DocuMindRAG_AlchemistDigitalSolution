
GROQ_API_KEY=""
CHAT_MODEL=openai/gpt-oss-120b      # writes the final answer
QUERY_MODEL=openai/gpt-oss-20b      # generates multi-query search variations (fast)
REASONING_EFFORT=low                # gpt-oss: low | medium | high
TEMPERATURE=0.1

# --- Embeddings: runs locally, no key needed (downloads once, ~130 MB) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking (25% overlap keeps sentences intact across chunk edges) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=250

# --- Retrieval ---
MULTI_QUERY_COUNT=4                 # extra queries written by the LLM
FETCH_K=10                          # candidates fetched per query before MMR
MAX_CONTEXT_CHUNKS=6                # diverse chunks sent to the LLM after MMR
MMR_LAMBDA=0.6                      # 1.0 = most relevant only, lower = more variety
SCORE_THRESHOLD=0.45                # below this a chunk counts as "not relevant"
HISTORY_TURNS=6
EMBED_BATCH_SIZE=32
DEBUG_RETRIEVAL=false               # true = print match scores in the terminal (to tune SCORE_THRESHOLD)

# --- Summaries ---
SUMMARY_MAX_CHUNKS=60               # longer documents are sampled evenly (Groq free-tier limits)

# --- Uploads ---
MAX_FILES=3
MAX_FILE_MB=20

# --- OCR for scanned / image-only PDFs (needs: sudo apt install tesseract-ocr) ---
OCR_LANGUAGE=eng                    # multiple languages: "eng+urd"
